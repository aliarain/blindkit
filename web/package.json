{
  "name": "@blindkit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format:check": "prettier --check src scripts *.mjs *.json *.jsonc",
    "test": "node scripts/check-site.mjs",
    "deploy": "pnpm build && pnpm test && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "4.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.144.0"
  }
}
