<figure class="connection-example">
  <div class="connection-path" aria-label="Your AI sends a request through Blindkit to your app">
    <div class="connection-node">
      <span class="node-icon" aria-hidden="true">
        ✳
      </span>
      <strong>Your AI</strong>
      <span>Asks for an action</span>
    </div>
    <span class="connection-line" aria-hidden="true">
      →
    </span>
    <div class="connection-node connection-center">
      <img src="/favicon.svg" width="32" height="32" alt="" />
      <strong>Blindkit</strong>
      <span>Checks your rules</span>
    </div>
    <span class="connection-line" aria-hidden="true">
      →
    </span>
    <div class="connection-node">
      <span class="node-icon" aria-hidden="true">
        ↗
      </span>
      <strong>Your app</strong>
      <span>Receives the request</span>
    </div>
  </div>
  <div class="example-controls" role="group" aria-label="Example action">
    <span>Try an action</span>
    <button aria-pressed="true" data-mode="read">
      Read a post
    </button>
    <button aria-pressed="false" data-mode="write">
      Create a post
    </button>
  </div>
  <div class="example-request">
    <span>Your AI asks</span>
    <p id="demo-request">“Show me the first post.”</p>
  </div>
  <div class="example-outcome" role="status">
    <span id="rule-badge" class="decision-label">
      Allowed
    </span>
    <p id="demo-result">The post is returned. No approval needed.</p>
  </div>
  <div class="example-decision" id="example-decision" hidden>
    <button class="button" id="demo-approve">
      Approve this example
    </button>
    <button class="secondary-button" id="demo-decline">
      Decline
    </button>
  </div>
  <figcaption>Demo only. No real requests or API keys are used.</figcaption>
</figure>
<script>
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  const decision = document.querySelector<HTMLDivElement>('#example-decision')!;
  const badge = document.querySelector<HTMLSpanElement>('#rule-badge')!;
  const result = document.querySelector<HTMLParagraphElement>('#demo-result')!;
  const request = document.querySelector<HTMLParagraphElement>('#demo-request')!;
  function selectExample(write: boolean) {
    modeButtons.forEach((button) =>
      button.setAttribute('aria-pressed', String((button.dataset.mode === 'write') === write)),
    );
    request.textContent = write
      ? '“Create a post called Hello, world.”'
      : '“Show me the first post.”';
    badge.textContent = write ? 'Ask first' : 'Allowed';
    result.textContent = write
      ? 'Waiting for your approval. Nothing has been sent.'
      : 'The post is returned. No approval needed.';
    decision.hidden = !write;
  }
  function finishExample(approved: boolean) {
    badge.textContent = approved ? 'Approved once' : 'Declined';
    result.textContent = approved
      ? 'The example post is created. This approval is used up.'
      : 'The request is stopped. Nothing has changed.';
    decision.hidden = true;
    document.querySelector<HTMLButtonElement>('[data-mode="write"]')!.focus();
  }
  modeButtons.forEach((button) =>
    button.addEventListener('click', () => selectExample(button.dataset.mode === 'write')),
  );
  document.querySelector('#demo-approve')!.addEventListener('click', () => finishExample(true));
  document.querySelector('#demo-decline')!.addEventListener('click', () => finishExample(false));
</script>
