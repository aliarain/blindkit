---
import Site from '../layouts/Site.astro';
---

<Site title="Page not found">
  <main id="main" class="container error-page">
    <p class="eyebrow">404 / Not here</p>
    <h1>A path that leads nowhere.</h1>
    <p>This page may have moved. Start with the documentation, or head back to the landing page.</p>
    <a class="button" href="/docs/">
      Explore the docs <span aria-hidden="true">↗</span>
    </a>{' '}
    <a class="text-link" href="/">
      Back home →
    </a>
  </main>
</Site>
