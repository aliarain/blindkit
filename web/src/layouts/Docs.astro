---
import Site from './Site.astro';
import { navigation, docUrl } from '../lib/docs';
interface Props {
  title: string;
  description: string;
  slug: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, slug, headings = [] } = Astro.props;
const index = navigation.findIndex((item) => item.slug === slug);
const previous = navigation[index - 1];
const next = navigation[index + 1];
---

<Site title={title} description={description} docs slug={slug}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <details class="docs-nav" open>
        <summary>
          Browse the docs <span aria-hidden="true">⌄</span>
        </summary>
        <nav aria-label="Documentation">
          {[...new Set(navigation.map((item) => item.group))].map((group) => (
            <div class="nav-group">
              <p class="eyebrow">{group}</p>
              {navigation
                .filter((item) => item.group === group)
                .map((item) => (
                  <a
                    href={docUrl(item.slug)}
                    aria-current={slug === item.slug ? 'page' : undefined}
                  >
                    {item.title}
                  </a>
                ))}
            </div>
          ))}
        </nav>
      </details>
    </aside>
    <main id="main" class="docs-main">
      <header class="article-header">
        <p class="eyebrow">
          Documentation <span aria-hidden="true">/</span> {navigation[index]?.group}
        </p>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <article class="prose">
        <slot />
      </article>
      <nav class="doc-pagination" aria-label="Guide pagination">
        {previous ? (
          <a href={docUrl(previous.slug)}>
            <small>← Previous</small>
            <strong>{previous.title}</strong>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={docUrl(next.slug)}>
            <small>Next →</small>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    </main>
    <aside class="page-outline">
      <p class="eyebrow">On this page</p>
      <nav aria-label="On this page">
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </nav>
    </aside>
  </div>
</Site>
