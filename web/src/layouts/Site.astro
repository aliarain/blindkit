---
import Brand from '../components/Brand.astro';
import Search from '../components/Search.astro';
import '../styles/site.css';
interface Props {
  title: string;
  description?: string;
  docs?: boolean;
  slug?: string;
}
const {
  title,
  description = 'Connect your AI assistant to your apps. Keep API keys on your computer and choose what your AI can do.',
  docs = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Blindkit</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111316" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!Astro.site && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={`${title} — Blindkit`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body class:list={{ 'docs-page': docs }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <Brand />
        <nav aria-label="Main navigation">
          <a class="how-link" href="/#how-it-works">
            How it works
          </a>
          <a href="/docs/" aria-current={docs ? 'page' : undefined}>
            Docs
          </a>
          <a href="https://github.com/aliarain/blindkit">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
        {docs && <Search />}
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <Brand />
        <p>Open source. Yours to run.</p>
      </div>
      <nav aria-label="Footer">
        <a href="/docs/">Documentation</a>
        <a href="/docs/security/">Security</a>
        <a href="/license.txt">MIT license</a>
      </nav>
    </footer>
    <div id="copy-status" class="sr-only" role="status"></div>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.docs-nav');
      if (menu) {
        const desktop = matchMedia('(min-width: 821px)');
        function adaptMenu() {
          menu!.open = desktop.matches;
        }
        adaptMenu();
        desktop.addEventListener('change', adaptMenu);
      }
      document.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
        if (!pre.querySelector('code')) return;
        const button = document.createElement('button');
        button.className = 'copy-code';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')!.textContent ?? '');
            button.textContent = 'Copied';
            document.querySelector('#copy-status')!.textContent = 'Code copied to clipboard.';
          } catch {
            button.textContent = 'Select code';
            document.querySelector('#copy-status')!.textContent =
              'Clipboard unavailable. Select and copy the code manually.';
          }
          setTimeout(() => (button.textContent = 'Copy'), 2500);
        });
        pre.append(button);
      });
    </script>
  </body>
</html>
